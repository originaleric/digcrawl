# Add to the user's local Codex configuration.
[mcp_servers.digcrawl]
command = "/absolute/path/to/digcrawl"
# Codex may leave an MCP stdin pipe open after a tool run. Reclaim this
# adapter after 15 minutes without an actual tools/call; MCP pings do not
# extend that window. Generic hosts can use the standard unflagged command
# from mcp/README.md instead.
args = ["mcp", "--idle-timeout", "15m", "--config", "/absolute/path/to/digcrawl-skill.yaml"]
